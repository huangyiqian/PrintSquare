; ============================================================
; SD2 PrintSphere Lite - ESP8266 Bambu Cloud MQTT display
; ============================================================

[env:sd2]
platform = espressif8266
board = nodemcuv2
framework = arduino
monitor_speed = 115200
board_build.filesystem = littlefs
build_src_filter =
    +<main.cpp>

lib_deps =
    bodmer/TFT_eSPI@^2.5.43
    bblanchon/ArduinoJson@^7.3.1

build_flags =
    -Os
    -D PIO_FRAMEWORK_ARDUINO_LWIP_HIGHER_BANDWIDTH
    -D BEARSSL_SSL_BASIC
    -D MQTT_MAX_PACKET_SIZE=8192
    -D USER_SETUP_LOADED
    -D ST7789_2_DRIVER
    -D TFT_WIDTH=240
    -D TFT_HEIGHT=240
    -D TFT_CS=15
    -D TFT_DC=0
    -D TFT_RST=2
    -D TFT_BL=5
    -D TFT_MISO=-1
    -D SPI_FREQUENCY=27000000
    -D SPI_READ_FREQUENCY=20000000
    -D LOAD_GLCD
    -D LOAD_FONT2
    -D LOAD_FONT4
    -D LOAD_FONT6
    -D LOAD_FONT7
    -D LOAD_FONT8
    -D LOAD_GFXFF
